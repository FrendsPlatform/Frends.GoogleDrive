# Copy this file to .env and fill in real values. Never commit .env.
# Existing environment variables (e.g. in CI) take precedence over values in .env.

# Google service account key JSON, Base64-encoded and split into two parts
# (split is needed because of the GitHub secret size limit; concatenated Part1 + Part2 must be valid Base64).
# Generate with PowerShell:
#   $b64 = [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   $half = [int]($b64.Length / 2); $b64.Substring(0, $half); $b64.Substring($half)
GoogleDrive_CredBase64_Part1=xxx
GoogleDrive_CredBase64_Part2=xxx=

# ID of the Google Drive folder used for tests (shared with the service account). Optional.
GoogleDrive_FolderId=123
