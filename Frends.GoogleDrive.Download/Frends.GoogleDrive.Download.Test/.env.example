# Copy this file to .env and fill in the values. Do not commit .env.

# Base64-encoded service account key JSON.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("path\to\service-account.json"))
GoogleDrive_CredBase64_Part1=xxx

# Optional: remainder of the Base64 key if it was split into two parts.
GoogleDrive_CredBase64_Part2=xxx

# ID of a folder inside a Shared Drive. The service account must be a member
# with permission to create and delete files.
# From the URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GoogleDrive_FolderId=123
